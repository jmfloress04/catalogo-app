# Contrato de variables de entorno
# Copiar este archivo como `.env` y completar los valores reales.
# NUNCA subir `.env` a Git ni incluirlo en el contexto de docker build.

# --- Capa 1: Base de Datos (catalogo-db — mongo:7) ---
# Nota: Solo se aplican al inicializar un volumen /data/db vacio.
MONGO_INITDB_ROOT_USERNAME=catalogo_user
MONGO_INITDB_ROOT_PASSWORD=cambiar_esta_clave

# --- Capa 2: Backend API (catalogo-api — FastAPI + Uvicorn) ---
DB_HOST=catalogo-db
DB_PORT=27017
DB_NAME=catalogodb
DB_USER=catalogo_user
DB_PASSWORD=cambiar_esta_clave
# Nota para Kubernetes: Si se opta por usar una cadena única MONGO_URI
# por ejemplo, mongodb://user:pass@catalogo-db:27017/catalogodb?authSource=admin
# esa variable contiene la contraseña y deberá ubicarse COMPLETA en un Secret,
# NUNCA en un ConfigMap.
APP_VERSION=v1
ROOT_PATH=/api
SEED_DEMO=true

# --- Capa 3: Frontend Reverse Proxy (catalogo-frontend — Nginx unprivileged) ---
API_HOST=catalogo-api
API_PORT=8000
NGINX_ENVSUBST_FILTER=^API_